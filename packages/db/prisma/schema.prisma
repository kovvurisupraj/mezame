// Prisma schema for Anime Tracker
// Run: npx prisma migrate dev --name init
// Docs: prisma.io/docs

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── Users ───────────────────────────────────────────────────────
// Added: Phase 1

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  authProvider String   // "google" | "discord"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences  UserPreferences?
  animeEntries AnimeEntry[]
  countdowns   Countdown[]
  conversations AiConversation[]
  memories     UserMemory[]

  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  preferredGenres      String[]
  avoidedGenres        String[]
  preferredStudios     String[]
  notificationSettings Json     @default("{}")
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Anime Library ────────────────────────────────────────────────
// Added: Phase 1

model AnimeEntry {
  id              String    @id @default(cuid())
  userId          String
  anilistId       Int
  status          String    // "watching" | "completed" | "on_hold" | "dropped" | "plan_to_watch"
  score           Decimal?  @db.Decimal(3, 1)
  episodesWatched Int       @default(0)
  totalEpisodes   Int?
  rewatchCount    Int       @default(0)
  notes           String?
  isFavourite     Boolean   @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@unique([userId, anilistId])
  @@map("anime_entries")
}

model WatchHistory {
  id            String   @id @default(cuid())
  entryId       String
  episodeNumber Int
  watchedAt     DateTime @default(now())

  entry AnimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}

// ─── Countdowns ───────────────────────────────────────────────────
// Added: Phase 2

model Countdown {
  id            String   @id @default(cuid())
  userId        String
  title         String
  type          String   // "episode" | "season" | "movie" | "custom"
  targetDate    DateTime
  anilistId     Int?
  episodeNumber Int?
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("countdowns")
}

// ─── AI Layer ─────────────────────────────────────────────────────
// Added: Phase 3+

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "recommendation" | "rag_chat" | "research"
  messages  Json     @default("[]")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_conversations")
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  memoryKey String
  content   String
  source    String   // "conversation" | "explicit" | "inferred"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_memory")
}

// ─── Eval Logs ────────────────────────────────────────────────────
// Added: Phase 8

model AiEvalLog {
  id             String   @id @default(cuid())
  feature        String   // "rag" | "recommendation" | "agent"
  input          Json
  output         Json
  qualityScore   Decimal? @db.Decimal(3, 2)
  judgeReasoning String?
  latencyMs      Int?
  costUsd        Decimal? @db.Decimal(8, 6)
  modelUsed      String?
  createdAt      DateTime @default(now())

  @@map("ai_eval_logs")
}
